#!/usr/bin/env python3
"""hyperlink-paths: wrap filesystem paths in stdin with OSC 8 px0:// hyperlinks.

Usage:
    <command> 2>&1 | hyperlink-paths [-0] [--base DIR]
    hyperlink-paths [--base DIR] < file

Each line of input is scanned for substrings that look like file paths:
absolute paths (/etc/hosts), home-relative paths (~/notes.md), dot-relative
paths (./x, ../y), and bare relative paths with a slash (src/main.py).
Paths with spaces ("./my dir/f.txt") match too. A trailing :line, :line:col,
or :line:col:text suffix (vimgrep locations like src/main.py:1:1:match) is
kept in the visible text and encoded as ?line=N query parameters, so the
visible text is unchanged and the click target carries the line number.
ANSI color codes around paths are preserved and do not break matching;
pre-existing OSC 8 hyperlinks pass through byte-identical.

Matched text is wrapped as an OSC 8 hyperlink whose URI is
px0://<percent-encoded-absolute-path>[?line=N[&col=M]]. Terminals that
support OSC 8 (Ghostty, Herdr, iTerm2, Kitty, WezTerm) render it clickable;
the px0:// scheme handler (px0-open) turns the click into a px0 window.

Paths are resolved against --base (default: the caller's cwd) so relative
matches click through to the right file. Matches that do not exist on disk
are left as plain text to avoid turning prose (input/output, foo/bar) into
dead links. Set --no-exists-check to link without probing the filesystem.

Options:
    --base DIR           resolve relative paths against DIR (default: cwd)
    --no-exists-check    hyperlink matches without checking the filesystem
    -0, --null           split input on NUL bytes (for rg --null / fd -0)

Examples:
    rg --vimgrep foo 2>&1 | hyperlink-paths
    git status --short | hyperlink-paths
    ls -R | hyperlink-paths
"""
import argparse
import os
import re
import sys
import urllib.parse

OSC8_OPEN_FMT = "\x1b]8;;{uri}\x1b\\"
OSC8_CLOSE = "\x1b]8;;\x1b\\"

# Candidate path token: starts at /, ~/, ./, ../, $VAR/, .name/, word/,
# and continues over word chars, dots, slashes, spaces and common filename
# punctuation, with an optional :line[:col] trailer. Brackets and parens
# are allowed *inside* a token (Next.js "[id]", route groups "(auth)")
# because the exists-check rejects prose like "(see notes)": only real
# files link. Spaces are included so paths like "/tmp/my dir/f o.txt"
# match; over-long matches are trimmed back to the longest existing prefix
# in linkify_line. The space continuation is capped at MAX_SPACE_SEGMENTS
# so a path buried in a huge prose run does not swallow the rest of the
# line (finditer then resumes scanning after the capped match, so later
# paths on the same line still link).
MAX_SPACE_SEGMENTS = 12
SEG = r"[^\s\"'`<>\[\]{}|!;,]"
BRK = r"[\(\)\[\]]"
PATH_RE = re.compile(
    r"(?P<path>"
    # Branch 1 (absolute paths) requires at least one non-space path char
    # after the leading slash: a bare "/" (prose like "true / false") must
    # never become a hyperlink to the filesystem root.
    r"(?:/(?:" + SEG + r"|" + BRK + r")+"
    r"(?: (?![A-Za-z]+://|\.{0,2}/|~/)(?:" + SEG + r"|" + BRK + r")+){0," + str(MAX_SPACE_SEGMENTS) + r"})"
    r"|(?:~|\.{1,2}|\$[A-Za-z_]\w*|\.[\w][\w\-.]*|[\w][\w\-.]*)(?:/(?:" + SEG + r"|" + BRK + r")*)+"
    r"(?: (?![A-Za-z]+://|\.{0,2}/|~/)(?:" + SEG + r"|" + BRK + r")+){0," + str(MAX_SPACE_SEGMENTS) + r"}"
    r")"
    r"(?P<trailer>:[0-9]+(?::[0-9]+)?)?"
)

TRAILING_PUNCT = ".,:;!?)]}"

# ANSI CSI sequences (SGR colors, cursor moves, etc.) wrap path text when
# tools force color on pipes (--color=always). linkify_line skips tokens
# containing control bytes, so without special handling a colorized path
# like ESC[35msrc/f.txtESC[0m would glue into an unresolvable token and
# stay plain. Splitting the line into plain/ANSI runs and linkifying only
# the plain runs keeps colors intact while making the paths clickable.
# OSC 8 hyperlinks (ESC]...ESC\\) contain no CSI opener and pass through
# as glued tokens that the control-byte guard preserves byte-identical.
ANSI_CSI_RE = re.compile(r"(\x1b\[[0-9;?]*[ -/]*[@-~])")

# Zero-width placeholder standing in for one ANSI CSI run while matching.
# It lives in the Unicode private-use area so it cannot collide with real
# path text; runs are restored verbatim before output.
ANSI_RUN_PLACEHOLDER = "\ue000"


def strip_trailing_punct(token):
    """Split terminal punctuation (sentence periods, closing parens) off."""
    stripped = token.rstrip(TRAILING_PUNCT)
    return stripped, token[len(stripped):]


def split_line_suffix(path):
    """Split path into (path, line, col, rest).

    Handles trailing :line, :line:col, and :line:col:text suffixes, so
    vimgrep-style locations like src/main.py:1:1:match text keep the
    location in the link while the match text stays plain. rest is the
    trailing ":text" portion ("" when absent).

    ANSI_RUN_PLACEHOLDER runs (folded CSI escapes, see linkify_line) are
    allowed around the structural colons so colorized separators
    ("pathESC[0m:ESC[32m10ESC[0m") still parse; they stay in the returned
    strings (skeleton space) and are stripped by resolve() for the URI.
    """
    ph = ANSI_RUN_PLACEHOLDER
    # Every structural colon tolerates surrounding folded CSI runs
    # ("pathESC[0m:ESC[32m10ESC[0m"); captured line/col stay pure digits.
    sep = ph + "*:"
    m = re.match(
        r"^(?P<p>.*?)" + sep + ph + r"*(?P<line>[0-9]+)"
        r"(?:" + sep + ph + r"*(?P<col>[0-9]+)(?P<rest>" + sep + r".+)?|(?P<rest2>" + sep + r".+)?)$",
        path,
    )
    if m:
        rest = m.group("rest") if m.group("rest") is not None else (m.group("rest2") or "")
        # A stray trailing colon on the path remainder (malformed
        # "file::line" output) is never part of a real path; peel it so
        # the exists-check below sees the actual file. Whole-token exact
        # matches are tried first by the caller, so a file genuinely
        # ending in ":" still links exactly.
        return m.group("p").rstrip(":"), m.group("line"), m.group("col"), rest
    return path, None, None, ""


def resolve(candidate, base):
    """Resolve a candidate token against base; return absolute path or None."""
    # Strip folded ANSI placeholders (see linkify_line): matching happens
    # in skeleton space, but the filesystem never sees them.
    candidate = candidate.replace(ANSI_RUN_PLACEHOLDER, "")
    if candidate.startswith("~"):
        candidate = os.path.expanduser(candidate)
    elif candidate.startswith("$"):
        var, _, rest = candidate[1:].partition("/")
        value = os.environ.get(var)
        if not value:
            return None
        candidate = value + ("/" + rest if rest else "")
    elif not os.path.isabs(candidate):
        candidate = os.path.join(base, candidate)
    return os.path.normpath(candidate)


def hyperlink_target(abs_path, line, col):
    # abs_path may hold lone surrogates from surrogateescape-decoded
    # non-UTF-8 bytes; quote() with errors="surrogateescape" maps them back
    # to the original bytes instead of raising UnicodeEncodeError.
    quoted = urllib.parse.quote(abs_path, safe="/", errors="surrogateescape")
    query = ""
    if line:
        query = "?line=" + line
        if col:
            query += "&col=" + col
    return "px0://" + quoted + query


def linkify_line(line, base, check_exists):
    # Fold ANSI CSI runs into zero-width placeholders so a path fractured
    # by color escapes ("/tmp/\x1b[31magy-review\x1b[0m/open.sh") still
    # matches as one token, and line numbers separated from their path by
    # colorized colons ("path\x1b[0m:\x1b[32m10\x1b[0m") still attach.
    # Runs are restored verbatim around the linkified skeleton: the visible
    # text keeps its colors, and the OSC 8 target/URI never contains them.
    # A line without color takes the single-run fast path, which is exactly
    # the old behavior.
    runs = ANSI_CSI_RE.split(line)
    if len(runs) == 1:
        return _linkify_run(line, base, check_exists)
    skeleton = ANSI_RUN_PLACEHOLDER.join(
        runs[i] for i in range(0, len(runs), 2)
    )
    linked = _linkify_run(skeleton, base, check_exists)
    parts = linked.split(ANSI_RUN_PLACEHOLDER)
    out = []
    for i, part in enumerate(parts):
        out.append(part)
        if i < len(runs) // 2:
            out.append(runs[2 * i + 1])
    return "".join(out)


def _linkify_run(line, base, check_exists):
    out = []
    pos = 0
    for m in PATH_RE.finditer(line):
        token = m.group("path") + (m.group("trailer") or "")
        token, punct = strip_trailing_punct(token)
        # Folded ANSI placeholders at the token edge belong to the
        # surrounding runs, not the path: move trailing ones to punct so
        # end-anchored :line parsing sees a clean boundary. Order is
        # preserved for verbatim restore. (A match never starts with a
        # placeholder: no PATH_RE branch opens with one.)
        while token.endswith(ANSI_RUN_PLACEHOLDER):
            token = token[: -len(ANSI_RUN_PLACEHOLDER)]
            punct = ANSI_RUN_PLACEHOLDER + punct
        if not token:
            continue
        if any(ord(c) < 0x20 or ord(c) == 0x7F for c in token):
            # Control characters (notably ESC inside existing OSC 8
            # hyperlinks, whose URI and display text would otherwise glue
            # into one token) never appear in clickable paths. Leave the
            # original bytes untouched so existing hyperlinks survive.
            continue
        body, line_no, col_no, suffix_rest = split_line_suffix(token)
        abs_path = resolve(body, base)
        if abs_path is None:
            continue
        if not check_exists or os.path.exists(abs_path):
            if suffix_rest:
                # vimgrep-style "file:line:col:text": keep the location in
                # the link, leave the match text plain.
                token = token[: len(token) - len(suffix_rest)]
                punct = suffix_rest + punct
            elif not check_exists and " " in token:
                # Without the exists-check there is no longest-existing
                # prefix to trim back to, so a greedy space run would
                # swallow trailing prose into the URI. Trim back to the
                # last slash-delimited segment instead: real paths keep
                # their directories, prose stays plain. The URI is rebuilt
                # from the trimmed token so it never carries prose.
                words = token.split(" ")
                cut = len(words) - 1
                while cut > 0 and "/" not in words[cut]:
                    cut -= 1
                if cut < len(words) - 1:
                    token = " ".join(words[: cut + 1])
                    # One separator space (token/prose boundary); the old
                    # punct stays glued as it was (e.g. "here.").
                    punct = " " + " ".join(words[cut + 1 :]) + punct
                    body, line_no, col_no, suffix_rest = split_line_suffix(token)
                    abs_path = resolve(body, base)
                    if suffix_rest:
                        token = token[: len(token) - len(suffix_rest)]
                        punct = suffix_rest + punct
        else:
            # The first split assumed the numeric tail was a line number,
            # but the stripped path did not exist. For "path WORDS:line"
            # the tail may be prose ("/tmp/demo.txt notes:42"), so retry
            # with the number kept as literal path text: the longest
            # existing space-prefix then keeps the full visible text.
            alt_body = body + (":" + line_no if line_no else "") + (":" + col_no if col_no else "")
            alt_abs = resolve(alt_body, base)
            if alt_abs is not None and os.path.exists(alt_abs):
                body, abs_path = alt_body, alt_abs
                line_no, col_no, suffix_rest = None, None, ""
                token = alt_body
            else:
                # Keep the stripped number in the trim input so prefix
                # trimming works on "/tmp/demo.txt notes:42" (preserving
                # ":42" in the rescanned remainder) rather than on the
                # stripped body (which would delete it).
                hit = None
                prefixes = [alt_body]
                if " " in alt_body:
                    words = alt_body.split(" ")
                    # Cap the trim-back attempts: each prefix costs a regex
                    # plus several stats, so an uncapped walk is quadratic.
                    # MAX_SPACE_SEGMENTS already bounds the number of space
                    # segments the regex can produce.
                    prefixes.extend(" ".join(words[:i])
                                    for i in range(len(words) - 1, max(len(words) - 1 - MAX_SPACE_SEGMENTS, 0), -1))
                for prefix in prefixes:
                    raw_rest = alt_body[len(prefix):]
                    if raw_rest and not raw_rest.startswith(" "):
                        # Cut mid-word, not at a space boundary; keep looking.
                        continue
                    # Prefixes may end in brackets/parens that belong to
                    # prose ("/etc/hosts) end"): peel them into the
                    # remainder so the exists-check sees the bare path.
                    p_stripped, p_punct = strip_trailing_punct(prefix)
                    if not p_stripped:
                        continue
                    p_body, p_line, p_col, p_suffix = split_line_suffix(p_stripped)
                    p_abs = resolve(p_body, base)
                    if p_abs is not None and os.path.exists(p_abs):
                        # The :line:col:text suffix stays out of the visible
                        # link; only path:line:col is underlined.
                        link_text = p_stripped[: len(p_stripped) - len(p_suffix)] if p_suffix else p_stripped
                        # The trimmed remainder may hold more paths ("a /etc/hosts
                        # and b src/main.py"); rescan it rather than emitting plain.
                        after = p_suffix + p_punct + raw_rest
                        rescanned = linkify_line(after, base, check_exists) if after else ""
                        hit = (link_text, p_abs, p_line, p_col, rescanned)
                        break
                if hit is None:
                    continue
                token, abs_path, line_no, col_no, after = hit
                # The remainder goes back after the link, already rescanned
                # for further paths above; the regex trailer and any stripped
                # punctuation follow it.
                punct = after + (m.group("trailer") or "") + punct
        out.append(line[pos:m.start()])
        uri = hyperlink_target(abs_path, line_no, col_no)
        out.append(OSC8_OPEN_FMT.format(uri=uri) + token + OSC8_CLOSE + punct)
        # m.end() is the exact end of the original match; token/punct may
        # now be longer (rescanned links) or shorter (trimmed prose).
        pos = m.end()
    out.append(line[pos:])
    return "".join(out)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--base", default=None, help="resolve relative paths against DIR")
    ap.add_argument("--no-exists-check", action="store_true",
                    help="hyperlink matches without checking the filesystem")
    ap.add_argument("-0", "--null", action="store_true", help="split input on NUL bytes")
    ap.add_argument("-u", "--line-buffered", action="store_true",
                    help="emit each line as it arrives instead of buffering "
                    "to EOF (for tail -f, ping, long builds under px). "
                    "Only applies to newline-delimited input.")
    args = ap.parse_args(argv)

    base = os.path.abspath(os.path.expanduser(args.base)) if args.base else os.getcwd()
    check_exists = not args.no_exists_check

    stdout = sys.stdout.buffer
    if args.line_buffered and not args.null:
        # Streaming mode: linkify line by line so long-running commands
        # show output live. Wrapped (multi-line) paths cannot link across
        # the line boundary; prefer the default buffered mode for files.
        stdin = sys.stdin.buffer
        while True:
            raw = stdin.readline()
            if not raw:
                break
            text = raw.decode("utf-8", errors="surrogateescape")
            linked = linkify_line(text.rstrip("\n"), base, check_exists)
            stdout.write(linked.encode("utf-8", errors="surrogateescape"))
            if raw.endswith(b"\n"):
                stdout.write(b"\n")
            stdout.flush()
        return 0

    data = sys.stdin.buffer.read()
    terminator_out = "\0" if args.null else "\n"
    chunks = data.split(b"\0") if args.null else data.split(b"\n")

    for i, raw in enumerate(chunks):
        # A trailing newline/NUL leaves an empty final chunk; the
        # terminator was already emitted with the previous chunk.
        if i == len(chunks) - 1 and raw == b"":
            break
        try:
            text = raw.decode("utf-8", errors="surrogateescape")
        except Exception:
            text = raw.decode("utf-8", errors="replace")
        linked = linkify_line(text, base, check_exists)
        # surrogateescape round-trips arbitrary input bytes exactly, so
        # non-UTF8 output (e.g. latin-1 compiler messages) passes through
        # byte-identical outside the hyperlink escape sequences.
        stdout.write(linked.encode("utf-8", errors="surrogateescape"))
        # Re-emit the separator consumed by split(); this preserves a
        # trailing newline/NUL exactly without adding an extra one.
        if i < len(chunks) - 1:
            stdout.write(terminator_out.encode())
    stdout.flush()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        # Downstream closed the pipe early (e.g. `... | head`): close
        # stdio so interpreter shutdown has nothing left to flush (which
        # would print "Exception ignored" noise), then exit with the
        # conventional SIGPIPE status like standard Unix filters.
        try:
            sys.stdout.close()
        except Exception:
            pass
        try:
            sys.stderr.close()
        except Exception:
            pass
        raise SystemExit(141)

#!/usr/bin/env bash
# px0-open: open a file path or px0:///file URL in the px0 file browser.
#
# Usage:
#   px0-open <path>[:line[:col]]     open a filesystem path in px0
#   px0-open 'px0:///abs/path?line=N'  open a px0:// URL (from OSC 8 clicks)
#   px0-open 'file:///abs/path'        open a file:// URL in px0
#   px0-open -- <target>               open a target starting with -
#
# Accepts absolute paths, ~/ paths, and paths relative to the current
# directory. A trailing :line or :line:col suffix is stripped because the
# px0 CLI takes a file or directory argument. The px0 server is launched
# detached so click handlers return immediately; px0 opens the browser
# itself unless configured otherwise.
set -u

PX0_BIN="${PX0_BIN:-$HOME/.local/bin/px0}"
# Deterministic location: URL handlers launched by LaunchServices get a
# per-app TMPDIR, so $TMPDIR would scatter logs unpredictably.
LOG_DIR="${PX0_OPEN_LOG_DIR:-$HOME/.local/state/px0-open}"
LOG_FILE="$LOG_DIR/px0-open.log"
# Every click appends px0's startup narration, so trim the log back to a
# bounded tail on each run instead of growing it without limit.
LOG_MAX_BYTES=131072
LOG_KEEP_BYTES=65536

trim_log() {
    local size tmp
    [[ -f "$LOG_FILE" ]] || return 0
    size="$(wc -c <"$LOG_FILE" 2>/dev/null | tr -d ' ' || echo 0)"
    if [[ "$size" -gt "$LOG_MAX_BYTES" ]]; then
        # Unique temp file per process: rapid-click bursts trim
        # concurrently without sharing one fixed filename. cat (not mv)
        # back into place because this shell may already hold LOG_FILE
        # open via the non-terminal exec redirect above; a rename would
        # leave it writing to an unlinked inode.
        tmp="$(mktemp "${LOG_FILE%/*}/px0-open.XXXXXX")" || return 0
        # Drop to the first full line so a byte cut through a multibyte
        # UTF-8 sequence or escape code never leaves a broken seam.
        if tail -c "$LOG_KEEP_BYTES" "$LOG_FILE" 2>/dev/null | tail -n +2 >"$tmp"; then
            cat "$tmp" >"$LOG_FILE" 2>/dev/null || true
        fi
        rm -f "$tmp"
    fi
}

# When launched by LaunchServices as a URL handler, stdout is a pipe with
# no reader: writing to it blocks forever and leaves the handler instance
# hanging, which swallows later clicks (verified: a bash-script handler
# binary stuck on such a write and ate subsequent open events). Redirect to
# the log only when stdout is not a terminal AND stderr is not a terminal
# either: an explicit user pipe (`px0-open x | cat`) still has a live
# reader, and diagnostics must stay visible. (main.swift additionally sends
# the handler child's stdio to /dev/null, so the redirect below is a
# backstop for Herdr actions and other non-terminal callers.)
if [[ ! -t 1 && ! -t 2 ]]; then
    mkdir -p "$LOG_DIR" 2>/dev/null || true
    exec >>"$LOG_FILE" 2>&1
fi

usage() {
    # Header comment doubles as help: lines 2+ while they start with '#'.
    awk 'NR<2{next} /^(#|$)/{sub(/^# ?/,""); print; next} {exit}' "$0"
}

# Percent-decode a URI component. Resolved lazily because URL handlers
# (LaunchServices, Herdr actions) run with a minimal PATH. Never fails:
# when no python is usable the raw string passes through unchanged.
urldecode() {
    local py="${PX0_PYTHON:-}"
    if [[ -n "$py" && ! -x "$py" ]]; then
        py=""
    fi
    if [[ -z "$py" ]]; then
        py="$(command -v python3 2>/dev/null || true)"
    fi
    if [[ -z "$py" ]]; then
        for cand in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
            if [[ -x "$cand" ]]; then
                py="$cand"
                break
            fi
        done
    fi
    if [[ -z "$py" ]]; then
        printf '%s' "$1"
        return 0
    fi
    "$py" -c 'import sys, urllib.parse; sys.stdout.write(urllib.parse.unquote(sys.argv[1]))' "$1" 2>/dev/null || printf '%s' "$1"
}

# Parse a px0:// or file:// URL into an absolute filesystem path.
# Prints the path on stdout. Query strings (?line=N) and fragments are
# dropped; a host component (file://host/path, px0://host/path) is dropped.
url_to_path() {
    local url="$1" rest path
    rest="${url#*://}"
    rest="${rest%%\?*}"
    rest="${rest%%\#*}"
    if [[ "$rest" == /* ]]; then
        path="$rest"
    else
        # Leading component is a host name; drop it.
        path="/${rest#*/}"
    fi
    urldecode "$path"
}

# Strip a trailing :line or :line:col suffix. The suffix is a display
# convention from compilers and test runners, never part of the path the
# px0 CLI accepts -- so strip it whenever the remainder is non-empty,
# whether or not it exists yet (build artifacts get cleaned, broken
# symlinks fail -e, files may be created next). An exact on-disk match
# always wins first, so files genuinely ending in ":42" still open whole.
strip_line_suffix() {
    local t="$1" stripped
    if [[ -e "$t" ]]; then
        printf '%s' "$t"
        return 0
    fi
    stripped="$t"
    while [[ "$stripped" =~ ^(.*):[0-9]+$ ]]; do
        stripped="${BASH_REMATCH[1]}"
        if [[ -e "$stripped" ]]; then
            printf '%s' "$stripped"
            return 0
        fi
    done
    # Nothing on disk matched: peel :line/:line:col tails in a loop
    # (greedy .+ would stop after one level) so px0 receives a clean
    # path instead of "file:42:10".
    while [[ "$t" =~ ^(.+):[0-9]+$ ]]; do
        t="${BASH_REMATCH[1]}"
    done
    printf '%s' "$t"
}

main() {
    case "${1:-}" in
        -h|--help)
            usage
            exit 0
            ;;
        "")
            usage >&2
            exit 2
            ;;
    esac
    # A leading -- separates flags from the target so paths starting
    # with - can be opened explicitly.
    if [[ "$1" == "--" ]]; then
        shift
        if [[ $# -lt 1 ]]; then
            usage >&2
            exit 2
        fi
    fi
    local target="$1" path scheme=""
    # URL schemes are case-insensitive; only treat the target as a URL
    # when it actually contains :// so files named e.g. "px0" still work.
    if [[ "$target" == *://* ]]; then
        scheme="$(printf '%s' "${target%%://*}" | tr 'A-Z' 'a-z')"
    fi

    case "$scheme" in
        px0|file)
            path="$(url_to_path "$target")"
            ;;
        *)
            path="$target"
            ;;
    esac

    # Expand ~ and relative paths against the caller's cwd.
    if [[ "$path" == "~/"* || "$path" == "~" ]]; then
        path="${path/#\~/$HOME}"
    elif [[ "$path" != /* ]]; then
        path="$PWD/$path"
    fi

    path="$(strip_line_suffix "$path")"

    if [[ ! -x "$PX0_BIN" ]]; then
        printf 'px0-open: px0 binary not found at %s (set PX0_BIN)\n' "$PX0_BIN" >&2
        exit 1
    fi

    mkdir -p "$LOG_DIR" 2>/dev/null || true
    trim_log
    # Detached: the caller (terminal URL handler, Herdr action) returns
    # immediately while px0 serves and opens the browser.
    nohup "$PX0_BIN" "$path" >>"$LOG_FILE" 2>&1 &
    disown 2>/dev/null || true
    printf 'opening in px0: %s\n' "$path"
}

main "$@"
